---
const currentYear = new Date().getFullYear();
---

<footer class="w-full mt-6 bg-linear-to-br from-yellow-600 to-yellow-700 border-t border-amber-900/35 shadow-all">
	<div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between text-amber-50">
		<p class="text-xl sm:text-2xl font-bold tracking-tight">Mixx<span class="text-amber-200">Fit</span></p>
		<p class="flex items-center gap-2 text-sm sm:text-base text-amber-100/90">
			<span class="font-semibold">&copy; {currentYear}</span>
			<span class="h-4 w-px bg-amber-100/40" aria-hidden="true"></span>
			<span class="font-semibold text-amber-50">Milan Nikolic</span>
		</p>
	</div>
</footer>
